{% js %}
(function() {
    var spinner = document.getElementById('twinsies-spinner');
    var result = document.getElementById('twinsies-test-result');

    function busy(on) {
        if (spinner) { spinner.classList.toggle('hidden', !on); }
    }

    var testBtn = document.getElementById('twinsies-test');
    if (testBtn) {
        testBtn.addEventListener('click', function() {
            busy(true);
            result.textContent = '';
            result.className = 'light';

            Craft.sendActionRequest('POST', 'twinsies/settings/test')
                .then(function(response) {
                    var data = response.data || {};
                    result.textContent = data.message || '';
                    result.className = data.ok ? 'success' : 'error';
                })
                .catch(function(error) {
                    result.textContent = (error.response && error.response.data && error.response.data.message)
                        || {{ 'Could not reach the server.'|t('twinsies')|json_encode|raw }};
                    result.className = 'error';
                })
                .finally(function() { busy(false); });
        });
    }

    var disconnectBtn = document.getElementById('twinsies-disconnect');
    if (disconnectBtn) {
        disconnectBtn.addEventListener('click', function() {
            if (!confirm({{ 'Disconnect from Twinfield? Nothing already posted is affected.'|t('twinsies')|json_encode|raw }})) {
                return;
            }
            busy(true);
            Craft.sendActionRequest('POST', 'twinsies/auth/disconnect')
                .then(function() { window.location.reload(); })
                .finally(function() { busy(false); });
        });
    }

    var refreshBtn = document.getElementById('twinsies-refresh');
    if (refreshBtn) {
        refreshBtn.addEventListener('click', function() {
            busy(true);
            Craft.sendActionRequest('POST', 'twinsies/settings/refresh-meta')
                .then(function() { window.location.reload(); })
                .finally(function() { busy(false); });
        });
    }
})();
{% endjs %}
